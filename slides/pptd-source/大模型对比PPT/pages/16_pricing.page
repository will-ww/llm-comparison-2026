pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [48, 32, 400, 18]
    content:
      style: "$kicker"
      wrap: false
      text: 价格与性价比
  - elementId: title
    elementType: text
    bounds: [48, 54, 860, 34]
    content:
      style: "$pageTitle"
      wrap: false
      text: 四个价格带成型，单任务成本才是真实口径
  - elementId: bar
    elementType: shape
    bounds: [48, 94, 56, 4]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: chart
    elementType: image
    bounds: [48, 112, 590, 375]
    src: media/c4_pricing.png
    fit: {mode: contain}
    border: {style: solid, width: 1, color: "$faint"}
  - elementId: p1
    elementType: text
    bounds: [670, 118, 242, 112]
    content:
      style: "$body"
      text: |
        <p><strong>单价 ≠ 账单</strong></p>
        <p style="margin-top:4px"><span style="color:$muted">Opus 5.5 单任务成本 $19.07，是 GPT-6 Astra（$8.21）的 2.3 倍；Grok 4.7 单任务输出 8.1 万 token。</span></p>
  - elementId: sep1
    elementType: shape
    bounds: [670, 240, 242, 1]
    shapeName: rect
    fill: {type: solid, color: "$faint"}
  - elementId: p2
    elementType: text
    bounds: [670, 256, 242, 112]
    content:
      style: "$body"
      text: |
        <p><strong>缓存是隐藏杠杆</strong></p>
        <p style="margin-top:4px"><span style="color:$muted">DeepSeek V4 Pro 缓存命中输入价 $0.0036/百万 token，比未命中低两个数量级；Argon 缓存输入降 95%。</span></p>
  - elementId: sep2
    elementType: shape
    bounds: [670, 378, 242, 1]
    shapeName: rect
    fill: {type: solid, color: "$faint"}
  - elementId: p3
    elementType: text
    bounds: [670, 394, 242, 100]
    content:
      style: "$body"
      text: |
        <p><strong>一个数量级的差距</strong></p>
        <p style="margin-top:4px"><span style="color:$muted">月耗 1 亿输入 + 2000 万输出的中型 RAG 应用：GPT-4o 约 $450，DeepSeek V4 Pro 约 $38。</span></p>
  - elementId: footer
    elementType: text
    bounds: [48, 510, 760, 16]
    content:
      style: "$caption"
      wrap: false
      text: 来源：各厂商定价页、Swfte、TheRouter、MyClaw（2026-10-05）；DeepSeek/OpenAI 报告期内均有调价
  - elementId: pageno
    elementType: text
    bounds: [880, 510, 32, 16]
    content:
      style: "$caption"
      align: [right, top]
      wrap: false
      text: "16"
