pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [48, 32, 400, 18]
    content:
      style: "$kicker"
      wrap: false
      text: 能力维度 · 编码与智能体
  - elementId: title
    elementType: text
    bounds: [48, 54, 860, 34]
    content:
      style: "$pageTitle"
      wrap: false
      text: 口径最混乱的维度：独立复测与厂商自报差 5–50 个百分点
  - elementId: bar
    elementType: shape
    bounds: [48, 94, 56, 4]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: chart
    elementType: image
    bounds: [48, 112, 600, 375]
    src: media/c2_coding.png
    fit: {mode: contain}
    border: {style: solid, width: 1, color: "$faint"}
  - elementId: p1
    elementType: text
    bounds: [680, 120, 232, 116]
    content:
      style: "$body"
      text: |
        <p><strong>独立口径 Claude 包揽前二</strong></p>
        <p style="margin-top:4px"><span style="color:$muted">Vals 复测：Opus 5.5（65.15%）与 Sonnet 5.5（64.14%）领跑；长程基准 DeepSWE 则由 Gemini 4 Argon（77.9%）居首。</span></p>
  - elementId: sep1
    elementType: shape
    bounds: [680, 246, 232, 1]
    shapeName: rect
    fill: {type: solid, color: "$faint"}
  - elementId: p2
    elementType: text
    bounds: [680, 262, 232, 110]
    content:
      style: "$body"
      text: |
        <p><strong>国产落差更大</strong></p>
        <p style="margin-top:4px"><span style="color:$muted">Kimi K3 自报 TB 2.1 88.3%，但 TB 4.0 独立复测仅 19.7%——采购前务必用自有任务集实测。</span></p>
  - elementId: sep2
    elementType: shape
    bounds: [680, 382, 232, 1]
    shapeName: rect
    fill: {type: solid, color: "$faint"}
  - elementId: p3
    elementType: text
    bounds: [680, 398, 232, 96]
    content:
      style: "$body"
      text: |
        <p><strong>落地结论</strong></p>
        <p style="margin-top:4px"><span style="color:$muted">重度编码选 Claude 系；成本敏感选 Sonnet 5.5 或 GPT-6.1 Sol；自托管选 GLM-5.3 或 DeepSeek V4 Pro。</span></p>
  - elementId: footer
    elementType: text
    bounds: [48, 510, 760, 16]
    content:
      style: "$caption"
      wrap: false
      text: 来源：BenchLM/Vals、Morph、NeuralTrust（2026-09/10）；Terminal-Bench 版本间分数不可直接比较
  - elementId: pageno
    elementType: text
    bounds: [880, 510, 32, 16]
    content:
      style: "$caption"
      align: [right, top]
      wrap: false
      text: "14"
